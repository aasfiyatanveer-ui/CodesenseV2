# CodeSense V2 — Environment Variables
# Copy this to .env and fill in your values

# JWT Secret — change this!
SECRET_KEY=codesense-v2-change-this-secret

# ── AI Configuration ──────────────────────────────────────────────────────────

# GROQ API (PRIMARY — FREE & ULTRA FAST)
# 1. Go to: https://console.groq.com
# 2. Sign up (free, no credit card)
# 3. Create API key → paste here
GROQ_API_KEY=

# OLLAMA (OFFLINE FALLBACK)
# 1. Install: https://ollama.ai
# 2. Run: ollama pull codellama
# 3. It runs at localhost:11434 by default
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=codellama

# Database
DATABASE_URL=sqlite:///./codesense_v2.db
